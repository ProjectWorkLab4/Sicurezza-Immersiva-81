  m_Name: SO_Mission_Evacuation
  m_EditorClassIdentifier: SI81.UI::SI81.UI.MissionDefinition
  Id: 09
  Title: Evacuation
  Context: 'Ruolo: addetto all''evacuazione. Suona l''allarme in un edificio di uffici.
    Guida i colleghi lungo le vie d''esodo, controlla le stanze, chiudi le porte
    e raggiungi il punto di raccolta senza usare l''ascensore.'
  Icon: {fileID: 21300000, guid: d07138a654ea153468d51b7649b5afd6, type: 3}
  Image: {fileID: 0}
  GradientTop: {r: 0.105882354, g: 0.43137255, b: 0.20784314, a: 1}
  GradientBottom: {r: 0.34509805, g: 0.7137255, b: 0.36862746, a: 1}
  Complexity: 3
  SceneName: SCN_Evacuation
  Objectives:
  - Guida i colleghi alle uscite
  - Controlla le stanze del piano
  - Chiudi le porte dietro di te
  - Raggiungi il punto di raccolta
  Criteria:
  - Outcome: 0
    Text: Tutti al punto di raccolta in tempo
  - Outcome: 1
    Text: Evacuazione completa ma lenta
  - Outcome: 2
    Text: Persone ancora nell'edificio
  Levels:
  - Level: 1
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 2
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 3
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  IsTraining: 0
  DesignerNote: '(esempio) Contenuto segnaposto: il team proprietario lo sostituisce
    e toglie questo marcatore.'
