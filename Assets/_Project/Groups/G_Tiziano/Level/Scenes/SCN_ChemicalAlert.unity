  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d88f4fd9d1985d4c879467147e2a6f4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SI81.Tiziano.ChemicalAlert.Interaction.ChemicalAlertPanelUI
  director: {fileID: 1265974287}
  inputBindings: {fileID: 1671981074}
  sdsPanel: {fileID: 845110616}
  sdsText: {fileID: 493703314}
  sdsPictograms:
  - {fileID: 1875692304}
  - {fileID: 832781774}
  - {fileID: 964871146}
  - {fileID: 620414260}
  formicAcidSds: {fileID: 4900000, guid: 5159c293bb951974c89c8f9da0a6d458, type: 3}
  sdsDisplayText: "<b>SCHEDA DI SICUREZZA \u2014 ACIDO FORMICO (>90%)</b>\nCAS 64-18-6 
    |  ONU UN 1779  |  liquido incolore, vapori pungenti e soffocanti\n<b>PERICOLO</b>
    \u2014 H226: liquido e vapori infiammabili; possibili miscele esplosive.\nH331
    / H302: tossico se inalato; nocivo se ingerito.\nH314 / EUH071: gravi ustioni
    e lesioni oculari; corrosivo per le vie respiratorie.\n<b>DPI OBBLIGATORI</b>\nRespirazione:
    maschera pieno facciale, filtro per gas acidi tipo E o B.\nMani: guanti in gomma
    butilica o Viton; vietati lattice e stoffa.\nOcchi e corpo: occhiali a tenuta
    o visiera, tuta/grembiule antiacido.\n<b>INTERVENTO SULLO SVERSAMENTO</b>\nAllontana
    le persone, isola la zona ed elimina fiamme, scintille e fonti di calore.\nAttiva
    al massimo ventilazione o aspirazione forzata.\nContieni e assorbi con sabbia
    asciutta o legante inerte per acidi.\nNon usare segatura o materiali combustibili;
    proteggi scarichi e fognature.\n<b>ANTINCENDIO</b> \u2014 Polvere, CO2, schiuma
    resistente all'alcol o acqua nebulizzata; mai getto pieno.\n<b>PRIMO SOCCORSO</b>\nInalazione:
    porta all'aria aperta e chiama i soccorsi.\nPelle/occhi: togli gli indumenti
    contaminati e risciacqua per almeno 15 minuti.\n<b>EMERGENZE</b> \u2014 112 
    |  Centro Antiveleni 06 305 4343"
