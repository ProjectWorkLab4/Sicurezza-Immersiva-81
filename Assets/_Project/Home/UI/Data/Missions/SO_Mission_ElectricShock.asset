  Complexity: 4
  SceneName: SCN_ElectricShock
  Objectives:
  - Non toccare l'infortunato
  - Togli corrente dal quadro
  - Allontana il cavo isolato
  - Presta i primi soccorsi
  Criteria:
  - Outcome: 0
    Text: Corrente tolta e soccorso prestato
  - Outcome: 1
    Text: Corrente tolta, soccorso in ritardo
  - Outcome: 2
    Text: Soccorritore folgorato
