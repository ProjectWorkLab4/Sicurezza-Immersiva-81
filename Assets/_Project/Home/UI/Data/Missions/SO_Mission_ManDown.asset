  GradientBottom: {r: 0.24705882, g: 0.72156864, b: 0.627451, a: 1}
  Complexity: 2
  SceneName: SCN_ManDown
  Objectives:
  - Verifica la coscienza
  - Verifica la respirazione
  - Chiama i soccorsi
  - Esegui le manovre necessarie
  Criteria:
  - Outcome: 0
    Text: Hai gestito correttamente l'emergenza.
  - Outcome: 1
    Text: "La gestione dell'emergenza presenta alcune criticit\xE0."
  - Outcome: 2
    Text: "La gestione dell'emergenza \xE8 risultata insufficiente."
