  m_Name: SO_Mission_FireStarter
  m_EditorClassIdentifier: SI81.UI::SI81.UI.MissionDefinition
  Id: 01
  Title: Fire Starter
  Context: "Ruolo: addetto antincendio di piano. Open space al 2\xB0 piano, pausa
    pranzo: una ciabatta multipresa sovraccarica sotto una scrivania inizia a fumare.
    Riconosci il principio d'incendio, dai l'allarme e intervieni in sicurezza prima
    che il fumo raggiunga le vie d'esodo."
  Icon: {fileID: 21300000, guid: 09bec03acb04abc4ab42876eec7d9837, type: 3}
  Image: {fileID: 0}
  GradientTop: {r: 0.78431374, g: 0.2509804, b: 0.16470589, a: 1}
  GradientBottom: {r: 0.9490196, g: 0.6, b: 0.2901961, a: 1}
  Complexity: 2
  SceneName: SCN_FireStarter
  Objectives:
  - Trova la fonte del fumo
  - Dai l'allarme al coordinatore
  - Stacca la multipresa
  - Spegni con l'estintore
  Criteria:
  - Outcome: 0
    Text: Incendio spento e allarme dato in tempo
  - Outcome: 1
    Text: Incendio spento, ma allarme in ritardo
  - Outcome: 2
    Text: Il fumo raggiunge le vie d'esodo
  Levels:
  - Level: 1
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 2
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 3
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  IsTraining: 0
  DesignerNote: '(esempio) Contenuto segnaposto: il team proprietario lo sostituisce
    e toglie questo marcatore.'
