# EditorConfig for Sicurezza Immersiva 81 (Unity C#)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Naming rules (align with README.md & Assets/_Project/Docs/Nomenclatura.md)
dotnet_naming_rule.types_and_methods_pascal_case.severity = suggestion
dotnet_naming_rule.types_and_methods_pascal_case.symbols = public_types_and_members
dotnet_naming_rule.types_and_methods_pascal_case.style = pascal_case

dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case

dotnet_naming_symbols.public_types_and_members.applicable_kinds = class, struct, interface, enum, method, property, event
dotnet_naming_symbols.public_types_and_members.applicable_accessibilities = public

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

[*.{ps1,sh,yml,yaml,md,json}]
indent_style = space
indent_size = 2

[*.{unity,prefab,mat,asset,meta}]
trim_trailing_whitespace = false
insert_final_newline = false
