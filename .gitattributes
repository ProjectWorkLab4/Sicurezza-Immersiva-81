# Line-ending normalization policy.
# IMPORTANT: Git only reads a file named exactly ".gitattributes" (plural).
# This file replaces the ineffective ".gitattribute" (singular) that was
# previously committed and never took effect.
#
# Policy: text files are stored in the repository with LF endings on every
# platform. Working trees check out with LF as well, so behavior no longer
# depends on each developer's core.autocrlf setting.
# Auto-detect and normalize all remaining text files
* text=auto
# Unity serialized assets and meta files
*.asset       text eol=lf
*.meta        text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.playable    text eol=lf
*.inputactions text eol=lf
# Source code and documentation
*.cs          text eol=lf
*.shader      text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
# Binaries — never normalize
*.pdf         binary
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dll         binary
*.so          binary
*.aar         binary
*.jar         binary
*.keystore    binary
*.apk         binary
*.aab         binary
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
