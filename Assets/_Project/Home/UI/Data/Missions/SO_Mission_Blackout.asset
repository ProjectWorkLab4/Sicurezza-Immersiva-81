  GradientBottom: {r: 0.48235294, g: 0.35686275, b: 0.6509804, a: 1}
  Complexity: 3
  SceneName: SCN_Blackout
  Objectives:
  - Attiva la luce d'emergenza
  - Avvisa i colleghi vicini
  - Raggiungi il quadro elettrico
  - Segnala il guasto
  Criteria:
  - Outcome: 0
    Text: Tutti al sicuro e guasto segnalato
  - Outcome: 1
    Text: Tutti al sicuro, segnalazione tardiva
  - Outcome: 2
    Text: Un collega resta al buio in zona pericolosa
  Levels:
