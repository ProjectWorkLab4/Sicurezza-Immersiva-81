  m_Name: SO_Mission_MachineLock
  m_EditorClassIdentifier: SI81.UI::SI81.UI.MissionDefinition
  Id: 08
  Title: Machine Lock
  Context: "Ruolo: manutentore. Una pressa si \xE8 bloccata durante il ciclo. Prima
    di intervenire applica la procedura di blocco e segnalazione, verifica l'assenza
    di energia residua e solo dopo libera il pezzo."
  Icon: {fileID: 21300000, guid: 0acc98d6bd765994582b461821be6b22, type: 3}
  Image: {fileID: 0}
  GradientTop: {r: 0.24705882, g: 0.2901961, b: 0.33333334, a: 1}
  GradientBottom: {r: 0.49019608, g: 0.54901963, b: 0.6, a: 1}
  Complexity: 4
  SceneName: SCN_MachineLock
  Objectives:
  - Ferma la macchina
  - Applica il lucchetto di blocco
  - Verifica l'energia residua
  - Libera il pezzo incastrato
  Criteria:
  - Outcome: 0
    Text: Procedura completa e pezzo liberato
  - Outcome: 1
    Text: Procedura incompleta, nessun danno
  - Outcome: 2
    Text: Intervento a macchina attiva
  Levels:
  - Level: 1
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 2
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  - Level: 3
    UnlockedByDefault: 1
    TimeLimitSecondsOverride: 0
  IsTraining: 0
  DesignerNote: '(esempio) Contenuto segnaposto: il team proprietario lo sostituisce
    e toglie questo marcatore.'
